# TLS edge for the EduVibe stack. Caddy terminates HTTPS (automatic Let's
# Encrypt certs + renewal) and reverse-proxies to the internal containers.
# HTTP is auto-redirected to HTTPS for every configured hostname.
#
# api.edu-vibe.uz starts issuing a cert the moment its DNS A record resolves to
# this server; until then Caddy serves the other sites normally and keeps
# retrying that one in the background.
{
	email usnetflix022@gmail.com
}

# Target UNIQUE container names, never the generic service names. This host runs
# several stacks that also define `web` / `api`, all on the same Docker network,
# so `api` / `web` resolve to multiple containers (round-robin) and Caddy would
# intermittently proxy to a FOREIGN backend — e.g. login hitting another
# project's api and returning "Bad Request".
edu-vibe.uz, www.edu-vibe.uz {
	encode gzip zstd
	reverse_proxy eduvibe-web-1:80
}

api.edu-vibe.uz {
	encode gzip zstd
	reverse_proxy eduvibe-api-1:8080
}

admin.edu-vibe.uz {
	encode gzip zstd
	reverse_proxy eduvibe-admin-1:3000
}
